<h1>Users#show</h1>
<p>Find me in app/views/users/show.html.erb</p>
<div>
    <%= image_tag @user.image, size: '120x120'%><%= @user.name %>@<%= @user.nickname%>
    <hr>
    <%if @tweets %>
        <%@tweets.each do |tweet|%>
            <%= render 'layouts/tweet',tweet: tweet %>
        <%end%>
    <%end%>
</div>
